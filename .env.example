# ═══════════════════════════════════════════════════════════════
#  Social Scraper API — Configuration
# ═══════════════════════════════════════════════════════════════
#  Copier ce fichier en .env et remplir les valeurs.
#  Ne jamais committer .env dans Git.
# ═══════════════════════════════════════════════════════════════

# ── API ──────────────────────────────────────────────────────────────
# Clés API acceptées, séparées par des virgules.
# Vide = authentification désactivée (développement uniquement).
# En production, toujours renseigner au moins une clé.
API_KEYS=change-me-in-production,optional-second-key

# Nombre de requêtes autorisées par minute et par clé API
RATE_LIMIT_PER_MINUTE=60

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# Cache TTL en secondes (10 min par défaut)
CACHE_TTL=600

# TTL de rétention des résultats de job (1h par défaut)
JOB_RESULT_TTL=3600

# ── Worker / Scraping ─────────────────────────────────────────────────
# Timeout max d'un job de scraping (secondes)
JOB_TIMEOUT=300

# Playwright en mode headless (toujours true en prod)
SCRAPER_HEADLESS=true

# ── Logs ──────────────────────────────────────────────────────────────
# true = JSON structuré (prod) | false = texte lisible (dev)
LOG_JSON=true
DEBUG=false

# ── macOS uniquement ──────────────────────────────────────────────────
# Fix crash "fork pre-exec" sur macOS causé par les APIs proxy Objective-C
# non fork-safe. Sans cette variable, le worker RQ crashe à chaque job.
OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES

# ── Postgres (optionnel — non requis par le MVP) ──────────────────────
POSTGRES_DB=scraper
POSTGRES_USER=scraper
POSTGRES_PASSWORD=change-me-in-production

# ── Credentials plateformes sociales ─────────────────────────────────
# Instagram Graph API (optionnel — fallback scraper si absent)
USER_LONG_TOKEN=
APP_ID=
IG_USER_ID=
ID_PAGE=

# Facebook Graph API (optionnel)
FB_PAGE_ID=
FB_ACCESS_TOKEN=

# Instagram scraper (session Playwright)
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
